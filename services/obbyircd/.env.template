# ObbyIRCd Settings - https://github.com/obbyworld/ObbyIRCd/blob/unreal60_dev/.env.example
OBBYIRCD_DOMAIN=irc.${MAIN_DOMAIN}
OBBYIRCD_SERVER_NAME=${OBBYIRCD_DOMAIN}
OBBYIRCD_NETWORK_NAME=${MAIN_DOMAIN}
OBBYIRCD_DESCRIPTION="my obbyircd server, hosted by ${MAIN_DOMAIN}"
OBBYIRCD_ADMIN_EMAIL=admin@${MAIN_DOMAIN}
# // Oper credentials. Authenticate on IRC with:  /OPER ${OBBYIRCD_OPER_NAME} <password> Leave OBBYIRCD_OPER_PASSWORD empty to let the image auto-generate a strong random password on first run (printed to the log once, persisted to data/obbyircd/data/.oper_password). Set it for stable credentials.
OBBYIRCD_OPER_NAME=admin
OBBYIRCD_OPER_PASSWORD=
# // Hostmask the oper can /OPER from ("*" = any; tighten for production).
OBBYIRCD_OPER_MASK=*
# // Internal container ports (the image listens on these).
OBBYIRCD_SSL_PORT=6697
OBBYIRCD_WS_PORT=8080
# // Optional: set to enable JSON-RPC over TCP on OBBYIRCD_RPC_PORT. Route it behind a TLS reverse proxy in production -- do NOT expose directly.
OBBYIRCD_RPC_PASSWORD=
OBBYIRCD_RPC_PORT=8600
# // Optional: set to enable the filehost module (client uploads / link rehosting).
OBBYIRCD_FILEHOST_URL=
# // Persistent cloak keys (leave empty to auto-generate). For linked networks, set them explicitly so cloaks stay stable across restarts/servers. Generate with: `head -c 32 /dev/urandom | xxd -p -c 64`
OBBYIRCD_CLOAK_KEY1=
OBBYIRCD_CLOAK_KEY2=
OBBYIRCD_CLOAK_KEY3=
# // Voice channels (^ -prefixed) need the separate hosted-backend API service (https://github.com/obbyworld/hosted-backend), which is not part of this repo. These vars configure the IRCd's own TURN announcement for WebRTC.
OBBYIRCD_VOICE_TURN_EXTERNAL_URLS=
OBBYIRCD_VOICE_TURN_SHARED_SECRET=
OBBYIRCD_VOICE_TURN_TTL=21600
# // Optional: invite-page HTTP listener (join-the-network splash). Set OBBYIRCD_INVITE_PAGE_PORT to enable; front it with a TLS reverse proxy.
OBBYIRCD_INVITE_BASE_URL=
OBBYIRCD_INVITE_PAGE_PORT=
OBBYIRCD_INVITE_IRC_HOST=
OBBYIRCD_INVITE_IRC_PORT=
OBBYIRCD_INVITE_WEB_URL=
# // Optional: web push via the hosted-backend API.
OBBYIRCD_WEBPUSH_BACKEND_URL=
OBBYIRCD_WEBPUSH_BACKEND_KEY=


