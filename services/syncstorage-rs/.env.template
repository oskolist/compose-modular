# SyncStorage-rs Settings
SYNCSTORAGERS_DOMAIN=sync.$MAIN_DOMAIN
SYNCSTORAGERS_PORT=8011
# // Hawk master secret: used to derive signing + token secrets. Generate e.g. with: cat /dev/urandom | base32 | head -c64
SYNCSTORAGERS_MASTER_SECRET="{FILL}"
# // Tokenserver FxA metrics hash secret. Must NOT be the same as the master secret.
SYNCSTORAGERS_METRICS_HASH_SECRET="{FILL}"
# // PostgreSQL role password for the `sync` user on the shared postgres instance. Use URL-safe characters only (base32/hex) — it is embedded in a postgresql:// URL.
SYNCSTORAGERS_DB_PASSWORD="{FILL}"
# // Firefox Accounts endpoint. Defaults point at production Sync; override for staging:
SYNCSTORAGERS_FXA_EMAIL_DOMAIN=api.accounts.firefox.com
SYNCSTORAGERS_FXA_OAUTH_SERVER_URL=https://oauth.accounts.firefox.com
# // Logging: SYNC_HUMAN_LOGS=1 enables colored human-readable logs, RUST_LOG sets the level.
SYNCSTORAGERS_HUMAN_LOGS=1
SYNCSTORAGERS_LOGLEVEL=info


